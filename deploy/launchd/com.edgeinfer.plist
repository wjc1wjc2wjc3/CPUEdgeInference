<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CPUEdgeInference（macOS launchd）
  安装：sudo cp com.edgeinfer.plist /Library/LaunchDaemons/
        sudo launchctl load -w /Library/LaunchDaemons/com.edgeinfer.plist
  卸载：sudo launchctl unload -w /Library/LaunchDaemons/com.edgeinfer.plist
  日志：/var/log/edgeinfer.log 与 /var/log/edgeinfer.err
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edgeinfer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/CPUEdgeInference/.venv/bin/python</string>
        <string>-m</string>
        <string>edgeinfer.cli</string>
        <string>--model-dir</string>
        <string>/opt/CPUEdgeInference/models</string>
        <string>--backend</string>
        <string>llama-cpp</string>
        <string>--threads</string>
        <string>4</string>
        <string>--prefer-quant</string>
        <string>Q4_K_M</string>
        <string>serve</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/opt/CPUEdgeInference</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/edgeinfer.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/edgeinfer.err</string>
</dict>
</plist>
